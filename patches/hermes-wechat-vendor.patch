+    # ==== HERMES PATCH 2026-05-28: report notification consumer ====
+    async def _consume_report_notifications(self) -> None:
+        """Poll for report-push notifications from the platform API."""
+        _notif_dir = Path(self._hermes_home) / "weixin" / "notifications"
+        _notif_dir.mkdir(parents=True, exist_ok=True)
+        while self._running:
+            try:
+                for f in sorted(_notif_dir.glob("*.json"), key=lambda p: p.stat().st_mtime):
+                    if f.suffix != ".json":
+                        continue
+                    if f.name.endswith(".consumed"):
+                        continue
+                    try:
+                        with open(f, encoding="utf-8") as fh:
+                            notif = json.load(fh)
+                        if notif.get("type") != "report_push":
+                            continue
+                        if notif.get("target") and notif["target"] != self._account_id:
+                            continue
+                        _content = notif.get("content", "")
+                        _chat_id = notif.get("chat_id", "")
+                        if _chat_id and _content:
+                            await self.send(content=_content, chat_id=_chat_id)
+                        consumed = f.with_suffix(".consumed")
+                        f.rename(consumed)
+                    except Exception:
+                        logger.debug("[%s] Report notification check failed", self.name)
+            except Exception:
+                logger.debug("[%s] Report notification check failed", self.name)
+            await asyncio.sleep(3)
+    # ==== END HERMES PATCH ====
+
+    # ==== HERMES PATCH 2026-05-28: HTTP callback server for DT teaching ====
+    async def _start_callback_server(self) -> None:
+        """Start a minimal aiohttp server for receiving teaching callbacks from platform."""
+        _is_child = os.environ.get("HERMES_HOME", "").endswith("/child")
+        _port = int(os.getenv("WEIXIN_CALLBACK_PORT", "8006" if _is_child else "8005"))
+        _host = os.getenv("WEIXIN_CALLBACK_HOST", "0.0.0.0")
+        try:
+            app = web.Application()
+            app.router.add_post("/api/tutor/callback", self._handle_tutor_callback)
+            self._callback_runner = web.AppRunner(app)
+            await self._callback_runner.setup()
+            self._callback_site = web.TCPSite(self._callback_runner, _host, _port)
+            await self._callback_site.start()
+            logger.info("[%s] Tutor callback server started on %s:%d", self.name, _host, _port)
+        except Exception as exc:
+            logger.warning("[%s] Tutor callback server failed to start: %s", self.name, exc)
+
+    async def _handle_tutor_callback(self, request: "web.Request") -> "web.Response":
+        """Receive teaching response from platform and deliver via WeChat."""
+        try:
+            data = await request.json()
+            _lid = data.get("learner_id", "")
+            _ct = data.get("content", "")
+            if _lid and _ct:
+                await self.send(content=_ct, chat_id=_lid)
+                self._teaching_sessions[_lid] = time.time()
+                self._save_teaching_sessions()
+                logger.info("[%s] Tutor callback: sent to %s (%d chars)", self.name, _lid, len(_ct))
+            return web.Response(status=200, text="ok")
+        except json.JSONDecodeError:
+            return web.Response(status=400, text="invalid json")
+        except Exception as exc:
+            logger.warning("[%s] Tutor callback error: %s", self.name, exc)
+            return web.Response(status=500, text=str(exc))
+
+    async def _load_teaching_sessions(self) -> None:
+        """Load persisted teaching sessions from disk."""
+        try:
+            if self._teaching_sessions_path.exists():
+                data = json.loads(self._teaching_sessions_path.read_text(encoding="utf-8"))
+                now = time.time()
+                for k, v in data.items():
+                    if now - v < 7200:
+                        self._teaching_sessions[k] = v
+        except Exception:
+            pass
+
+    def _save_teaching_sessions(self) -> None:
+        """Persist teaching sessions to disk."""
+        try:
+            self._teaching_sessions_path.write_text(
+                json.dumps(self._teaching_sessions, ensure_ascii=False), encoding="utf-8"
+            )
+        except Exception:
+            pass
+    # ==== END HERMES PATCH ====
