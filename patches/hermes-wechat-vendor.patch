+    async def _run_teaching_flow(
+        self,
+        effective_chat_id: str,
+        message: str,
+        platform_url: str,
+        is_new_doc: bool,
+    ) -> None:
+        """Fire-and-forget teaching flow with periodic status updates."""
+        _STATUS_INTERVAL = 6
+        _start = time.time()
+        _last_status = _start
+
+        try:
+            async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=120)) as session:
+                # Send status updates while waiting
+                async def _maybe_send_status():
+                    nonlocal _last_status
+                    elapsed = time.time() - _start
+                    if elapsed - (_last_status - _start) >= _STATUS_INTERVAL:
+                        _last_status = time.time()
+                        statuses = [
+                            "  正在识别题目类型...",
+                            "  正在生成详细讲解...",
+                            "  即将完成...",
+                        ]
+                        idx = min(int(elapsed / _STATUS_INTERVAL) - 1, len(statuses) - 1)
+                        if idx >= 0:
+                            try:
+                                await self.send(content=statuses[idx], chat_id=effective_chat_id)
+                            except Exception:
+                                pass
+
+                # Start the tutor_chat request
+                resp = await session.post(
+                    f"{platform_url}/api/tutor/chat",
+                    json={
+                        "message": message,
+                        "learner_id": effective_chat_id,
+                        "context": "",
+                        "mode": "guide",
+                    },
+                )
+                await _maybe_send_status()
+
+                if resp.status == 200:
+                    data = await resp.json()
+                    reply = data.get("content", "") if data.get("ok") else ""
+                    if reply:
+                        await self.send(content=reply, chat_id=effective_chat_id)
+                        self._teaching_sessions[effective_chat_id] = time.time()
+                        self._save_teaching_sessions()
+                        logger.info(
+                            "[%s] Tutor reply sent to %s (%d chars, %.1fs)",
+                            self.name, effective_chat_id, len(reply), time.time() - _start,
+                        )
+                        return
+
+                # Fallback: if tutor_chat returned no content, try agent
+                logger.warning("[%s] Tutor chat returned empty, falling back", self.name)
+        except Exception as exc:
+            logger.warning("[%s] Tutor chat failed, falling back to agent: %s", self.name, exc)
+
+        # Fallback to regular agent processing
+        await self.handle_message(self._build_dummy_event(effective_chat_id, message))
+
+    def _build_dummy_event(self, chat_id: str, text: str) -> "MessageEvent":
+        """Build a minimal MessageEvent for fallback agent processing."""
+        from gateway.platforms.base import MessageEvent, MessageType
+        source = self.build_source(chat_id=chat_id, chat_type="dm", user_id=chat_id, user_name=chat_id)
+        return MessageEvent(
+            text=text, message_type=MessageType.TEXT, source=source,
+            message_id="", raw_message={}, timestamp=datetime.now(),
+        )
