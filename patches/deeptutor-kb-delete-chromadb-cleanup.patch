+    @staticmethod
+    def _platform_url() -> str | None:
+        env = os.environ.get("PLATFORM_URL") or os.environ.get("PLATFORM_API_URL") or ""
+        return env.strip().rstrip("/") or None
+
+    @classmethod
+    def _notify_platform_kb_deleted(cls, kb_name: str) -> None:
+        """Notify platform to clean up ChromaDB collections for a deleted KB.
+
+        Best-effort: failures are logged but never block deletion.
+        """
+        platform_url = cls._platform_url()
+        if not platform_url:
+            return
+        try:
+            import json as _json
+            import urllib.request as _req
+
+            cleanup_url = f"{platform_url}/api/kb/cleanup-chromadb"
+            payload = _json.dumps({"kb_name": kb_name}).encode("utf-8")
+            req = _req.Request(
+                cleanup_url,
+                data=payload,
+                headers={"Content-Type": "application/json"},
+                method="POST",
+            )
+            with _req.urlopen(req, timeout=10) as resp:
+                result = _json.loads(resp.read().decode("utf-8"))
+                deleted = result.get("deleted", [])
+                if deleted:
+                    logger.info(
+                        "Platform ChromaDB cleanup for '%s': deleted %s", kb_name, deleted
+                    )
+        except Exception as exc:
+            logger.warning(
+                "Platform ChromaDB cleanup for '%s' failed (non-fatal): %s", kb_name, exc
+            )
+
