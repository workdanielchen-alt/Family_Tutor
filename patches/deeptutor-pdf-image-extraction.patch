+    async def _extract_pdf_images(self, file_path: Path) -> list[Document]:
+        """Extract embedded images from a PDF and create Document nodes with page context.
+
+        Images are NOT written to disk — only text Document nodes are created,
+        each carrying the page number and surrounding text so the image can be
+        discovered via text search even without multimodal embedding.  The
+        original PDF + page number serve as the canonical reference.
+
+        All images on the same page are aggregated into a single node to keep
+        the embedding batch size manageable for large textbooks.
+        """
+        if fitz is None:
+            self.logger.warning("Cannot extract PDF images: pymupdf not installed")
+            return []
+
+        nodes: list[Document] = []
+
+        try:
+            doc = fitz.open(file_path)
+        except Exception as exc:
+            self.logger.error("Failed to open PDF for image extraction: %s: %s", file_path.name, exc)
+            return []
+
+        try:
+            for page_num, page in enumerate(doc, 1):
+                image_list = page.get_images(full=True)
+                if not image_list:
+                    continue
+
+                page_text = (page.get_text() or "").strip()[:300]
+
+                # One node per page: list all image sizes found on this page.
+                # Skip images smaller than 16px in either dimension — they are
+                # nearly always layout noise or 1px spacers, never meaningful
+                # textbook figures.
+                img_infos: list[str] = []
+                for img_idx, img_info in enumerate(image_list):
+                    try:
+                        base_image = doc.extract_image(img_info[0])
+                        if base_image.get("image"):
+                            w = base_image.get("width", "?")
+                            h = base_image.get("height", "?")
+                            if (isinstance(w, int) and w < 16) or (isinstance(h, int) and h < 16):
+                                continue
+                            img_infos.append(f"  Image {img_idx + 1}: {w}×{h}px")
+                    except Exception:
+                        continue
+
+                if not img_infos:
+                    continue
+
+                text_parts = [
+                    f"[PDF Image] {file_path.name} — Page {page_num}, {len(img_infos)} image(s)",
+                ]
+                if page_text:
+                    text_parts.append(f"Surrounding text: {page_text}")
+                text_parts.append("Image details:")
+                text_parts.extend(img_infos)
+                text = "\n".join(text_parts)
+
+                nodes.append(
+                    Document(
+                        text=text,
+                        metadata={
+                            "file_name": file_path.name,
+                            "file_path": str(file_path),
+                            "page_number": page_num,
+                            "image_count": len(img_infos),
+                            "content_type": "pdf_image",
+                        },
+                    )
+                )
+
+            doc.close()
+        except Exception as exc:
+            self.logger.error("Error extracting images from %s: %s", file_path.name, exc)
+            try:
+                doc.close()
+            except Exception:
+                pass
+
+        if nodes:
+            self.logger.info(
+                "Indexed %d page-image node(s) from %s (no files saved to raw/)",
+                len(nodes),
+                file_path.name,
+            )
+        return nodes
+
