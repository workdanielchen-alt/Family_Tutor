+    async def _extract_pdf_images(self, file_path: Path) -> list[Document]:
+        """Extract embedded images from a PDF and create Document nodes with page context.
+
+        Images are NOT written to disk — only text Document nodes are created,
+        each carrying the page number and surrounding text so the image can be
+        discovered via text search even without multimodal embedding.  The
+        original PDF + page number serve as the canonical reference.
+        """
+        if fitz is None:
+            self.logger.warning("Cannot extract PDF images: pymupdf not installed")
+            return []
+
+        nodes: list[Document] = []
+
+        try:
+            doc = fitz.open(file_path)
+        except Exception as exc:
+            self.logger.error("Failed to open PDF for image extraction: %s: %s", file_path.name, exc)
+            return []
+
+        image_count = 0
+
+        try:
+            for page_num, page in enumerate(doc, 1):
+                image_list = page.get_images(full=True)
+                if not image_list:
+                    continue
+
+                page_text = (page.get_text() or "").strip()[:300]
+
+                for img_idx, img_info in enumerate(image_list):
+                    xref = img_info[0]
+                    try:
+                        base_image = doc.extract_image(xref)
+                    except Exception:
+                        continue
+
+                    if not base_image.get("image"):
+                        continue
+
+                    image_count += 1
+
+                    text_parts = [
+                        f"[PDF Image] {file_path.name} — Page {page_num}, Image {img_idx + 1}",
+                    ]
+                    if page_text:
+                        text_parts.append(f"Surrounding text: {page_text}")
+                    text = "\n".join(text_parts)
+
+                    nodes.append(
+                        Document(
+                            text=text,
+                            metadata={
+                                "file_name": file_path.name,
+                                "file_path": str(file_path),
+                                "page_number": page_num,
+                                "image_index": img_idx + 1,
+                                "content_type": "pdf_image",
+                                "image_width": base_image.get("width"),
+                                "image_height": base_image.get("height"),
+                            },
+                        )
+                    )
+
+            doc.close()
+        except Exception as exc:
+            self.logger.error("Error extracting images from %s: %s", file_path.name, exc)
+            try:
+                doc.close()
+            except Exception:
+                pass
+
+        if image_count > 0:
+            self.logger.info(
+                "Indexed %d image context(s) from %s (no files saved to raw/)",
+                image_count,
+                file_path.name,
+            )
+        return nodes
+
