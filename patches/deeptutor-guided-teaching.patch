+            from deeptutor.services.kb_navigation import KnowledgeNavigationService
+
+            resource = resolve_for_rag(kb_name)
+            if resource is None:
+                return ""
+            nav = KnowledgeNavigationService(kb_name, str(resource.base_dir))
+            syllabus = nav.get_syllabus()
+            if not syllabus:
+                return ""
+            lines: list[str] = []
+            if self.language == "zh":
+                lines.append(f"## 知识库教学参考\n已挂载知识库：{kb_name}\n")
