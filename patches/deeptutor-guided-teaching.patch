+                    lines.append(f"### {doc.title}")
+                    for sec in doc.sections[:5]:
+                        cs = ", ".join(
+                            c.label for c in nav.get_concepts_for_section(
+                                doc.doc_id, sec.heading
+                            )[:5]
+                        )
+                        lines.append(f"- {sec.heading}" + (f" → 概念：{cs}" if cs else ""))
+                lines.append("调用 kb_lookup_concept 查概念定义，kb_syllabus 浏览结构，rag 搜索段落。")
+            else:
+                lines.append(f"## Knowledge Base Teaching Context\nAttached: {kb_name}\n")
+                for doc in syllabus[:3]:
+                    lines.append(f"### {doc.title}")
+                    for sec in doc.sections[:5]:
+                        cs = ", ".join(
+                            c.label for c in nav.get_concepts_for_section(
+                                doc.doc_id, sec.heading
+                            )[:5]
+                        )
+                        lines.append(f"- {sec.heading}" + (f" → concepts: {cs}" if cs else ""))
+                lines.append("Use kb_lookup_concept for definitions, kb_syllabus for structure, rag for search.")
+            return "\n".join(lines)
+        except Exception as exc:
+            logger.debug("Failed to load KB teaching context: %s", exc)
+            return ""
+
