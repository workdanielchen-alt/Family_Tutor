+async def _trigger_ocr_for_pdfs(task_id: str, kb_name: str, raw_dir: Path) -> None:
+    """Fire-and-forget: trigger platform OCR for all PDFs in raw_dir."""
+    try:
+        import httpx
+        supported = [f for f in Path(raw_dir).iterdir() if f.suffix.lower() == ".pdf" and f.is_file()]
+        if not supported:
+            return
+        for fp in supported:
+            try:
+                with open(fp, "rb") as fh:
+                    r = httpx.post(
+                        "http://platform:8100/api/kb/ingest-file",
+                        data={"kb_name": kb_name},
+                        files={"file": (fp.name, fh, "application/pdf")},
+                        timeout=10,
+                    )
+                if r.status_code == 200:
+                    _task_log(task_id, f"OCR triggered for {fp.name}")
+                else:
+                    _task_log(task_id, f"OCR trigger HTTP {r.status_code} for {fp.name}", level="warning")
+            except Exception as exc:
+                _task_log(task_id, f"OCR trigger failed for {fp.name}: {exc}", level="warning")
+    except Exception:
+        pass  # fire-and-forget: never crash the caller
+
+
