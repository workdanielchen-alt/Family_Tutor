+    ) -> None:
+        """子网关：三态会话路由（教学 ↔ 暂停 ↔ 无会话）"""
+        _session = self._teaching_sessions.get(chat_id) or \
+                   self._teaching_sessions.get(sender_id)
+        _is_file = bool(media_paths)
