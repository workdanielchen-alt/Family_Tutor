+    def _load_teaching_sessions(self) -> None:
+        """Load persisted teaching sessions from disk.
+        
+        ɢ Supports both old (timestamp) and new (dict) disk formats.
+        """
+        try:
+            if self._teaching_sessions_path.exists():
+                data = json.loads(self._teaching_sessions_path.read_text(encoding="utf-8"))
+                now = time.time()
+                for k, v in data.items():
+                    if isinstance(v, (int, float)):
+                        # Old format: timestamp → migrate to dict
+                        if now - v < 7200:
+                            self._teaching_sessions[k] = self._new_session("active")
+                            self._teaching_sessions[k]["last_active"] = v
+                    elif isinstance(v, dict):
+                        # New format: dict with state
+                        _state = v.get("state", "active")
+                        _last = v.get("last_active", v.get("started_at", now))
+                        if now - _last < 7200:
+                            self._teaching_sessions[k] = v
+        except Exception:
+            pass
+
+    def _save_teaching_sessions(self) -> None:
+        """Persist teaching sessions to disk."""
+        try:
+            self._teaching_sessions_path.write_text(
+                json.dumps(self._teaching_sessions, ensure_ascii=False), encoding="utf-8"
+            )
+        except Exception:
+            pass
