+    @staticmethod
+    def _new_session(state: str = "active", question_num: int = 0,
+                     total_questions: int = 0, trace_id: str = "") -> dict:
+        _now = time.time()
+        return {
+            "state": state,
+            "started_at": _now,
+            "last_active": _now,
+            "question_num": question_num,
+            "total_questions": total_questions,
+            "trace_id": trace_id,
