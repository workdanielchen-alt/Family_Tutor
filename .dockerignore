# ============================================
# DeepTutor Docker Ignore File
# ============================================
# Excludes files and directories from the Docker build context
# to improve build speed and reduce image size
# ============================================

# ============================================
# Git
# ============================================
.git
.gitignore
.gitattributes

# ============================================
# Documentation
# ============================================
*.md
!README.md
docs/
assets/gifs/
assets/figs/
assets/README/

# ============================================
# Python
# ============================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.Python
build/
develop-eggs/
vendor/
!vendor/hermes-agent/
!vendor/deeptutor/
# Exclude vendor submodule junk to keep build context small
vendor/deeptutor/.git/
vendor/deeptutor/.github/
vendor/deeptutor/data/
vendor/deeptutor/deeptutor_web/
vendor/deeptutor/deeptutor_*/node_modules/
vendor/deeptutor/docs/
vendor/deeptutor/tests/
vendor/deeptutor/assets/
vendor/deeptutor/examples/
vendor/deeptutor/scripts/
vendor/deeptutor/site/
vendor/hermes-agent/node_modules/
vendor/hermes-agent/.venv/
dist/
downloads/
eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
MANIFEST

# Virtual environments
.env
*.env
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
DeepTutor.env

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Other Python tools
.tox/
.ruff_cache
.pyre/
.pytype/

# ============================================
# Node.js
# ============================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
web/.next/
.next2/
web/.next2/
out/
web/out/
web/.next-new/
web/.next.old

# ============================================
# IDE and Editor
# ============================================
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~
.DS_Store

# ============================================
# Docker
# ============================================
Dockerfile*
docker-compose*.yml
.docker/
.dockerignore

# ============================================
# Runtime Data (mounted as volumes, not built)
# ============================================
data/
data_dev/
test_data/
run_code_workspace/
multi-user/
output/
outputs/
**/output/
**/outputs/

# ============================================
# Development and Testing
# ============================================
develop/
scripts/extract_numbered_items.sh
*.log
logs/
*.bak
*.tmp

# Playwright test artifacts
web/playwright-report/
web/test-results/

# Test / coverage output
coverage.xml
nosetests.xml

# ============================================
# Temporary and Cache Files
# ============================================
.cache/
cache/
**/cache/
tmp/
temp/
*.tmp
*.temp

# AI assistant state
.claude
.deepseek/

# ============================================
# License and Communication
# ============================================
LICENSE
Communication.md

# ============================================
# Binary / Large Asset Files
# ============================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.mp3
*.wav
*.ogg

# Database files
*.db
*.sqlite
*.sqlite3

# Profiling
*.prof
*.pstats

# Jupyter
.ipynb_checkpoints/
